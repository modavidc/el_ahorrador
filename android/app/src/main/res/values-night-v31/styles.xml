<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: paper background with the Solito sun-coin on
         a red circle. The design is light-only, so day and night look the same. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/solito_paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/solito_red</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/solito_paper</item>
    </style>
</resources>
