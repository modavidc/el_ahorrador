    <!-- Fondo azul claro -->
    <item android:drawable="@color/splash_background" />

    <!-- Logo/Icono centrado -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
