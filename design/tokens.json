{
  "$description": "Money Manager IA — unified theme tokens. Single source of truth. Values in px (dp on Android).",
  "color": {
    "brand": {
      "primary": "#F0523C",
      "primaryPressed": "#D33F2B",
      "primarySoft": "#FBE0DA",
      "onPrimary": "#FFFFFF"
    },
    "semantic": {
      "income": "#2F80ED",
      "expense": "#F0523C",
      "neutralAmount": "#8A8A8A",
      "success": "#2EA862",
      "successSoft": "#E3F7EA",
      "ai": "#8A4FD6",
      "aiSoft": "#EFE3FC",
      "warning": "#F2994A"
    },
    "text": {
      "primary": "#222222",
      "secondary": "#555555",
      "tertiary": "#8A8A8A",
      "disabled": "#B0B0B0",
      "inverse": "#FFFFFF"
    },
    "surface": {
      "background": "#F4F4F6",
      "card": "#FFFFFF",
      "inputFill": "#F7F7F8",
      "inverse": "#3A3A3A",
      "scrim": "rgba(0,0,0,0.42)"
    },
    "border": {
      "default": "#EEEEEE",
      "subtle": "#F2F2F2",
      "input": "#E2E2E2"
    },
    "category": {
      "comida":        { "fg": "#F0523C", "bg": "#FBE0DA", "icon": "restaurant" },
      "hogar":         { "fg": "#A1674A", "bg": "#F3E4DC", "icon": "home" },
      "transporte":    { "fg": "#2F80ED", "bg": "#DBE8FB", "icon": "local_taxi" },
      "servicios":     { "fg": "#F2994A", "bg": "#FDEED9", "icon": "wifi" },
      "suscripciones": { "fg": "#D6457A", "bg": "#FADDE8", "icon": "subscriptions" },
      "familia":       { "fg": "#9B51E0", "bg": "#EFE3FC", "icon": "family_restroom" },
      "ocio":          { "fg": "#E0A800", "bg": "#FFF3C9", "icon": "sports_esports" },
      "compras":       { "fg": "#00A3A3", "bg": "#D7F2F2", "icon": "shopping_bag" },
      "salud":         { "fg": "#27AE60", "bg": "#DBF3E5", "icon": "medication" },
      "educacion":     { "fg": "#4F5BD5", "bg": "#E1E4F6", "icon": "school" },
      "otros":         { "fg": "#828282", "bg": "#ECECEC", "icon": "category" },
      "salario":       { "fg": "#2F80ED", "bg": "#DBE8FB", "icon": "payments" },
      "freelance":     { "fg": "#27AE60", "bg": "#DBF3E5", "icon": "work" },
      "inversiones":   { "fg": "#F2994A", "bg": "#FDEED9", "icon": "trending_up" },
      "transferencia": { "fg": "#8A8A8A", "bg": "#ECECEC", "icon": "swap_horiz" }
    }
  },
  "typography": {
    "fontFamily": "Roboto",
    "numericFeature": "tabular-nums",
    "scale": {
      "display":   { "size": 28, "weight": 700, "lineHeight": 34, "use": "Big totals (Stats screen)" },
      "title":     { "size": 20, "weight": 700, "lineHeight": 26, "use": "Screen title / month selector" },
      "headline":  { "size": 16, "weight": 600, "lineHeight": 22, "use": "Day group header, sheet titles" },
      "body":      { "size": 14, "weight": 400, "lineHeight": 20, "use": "Transaction title, inputs, chat" },
      "bodyStrong":{ "size": 14, "weight": 600, "lineHeight": 20, "use": "Amounts in rows" },
      "label":     { "size": 13, "weight": 500, "lineHeight": 18, "use": "Tabs, buttons small, summary labels" },
      "caption":   { "size": 12, "weight": 400, "lineHeight": 16, "use": "Meta line (category · account · time)" },
      "micro":     { "size": 11, "weight": 500, "lineHeight": 14, "use": "Chips, bottom-nav labels" }
    },
    "rules": [
      "No font size outside this scale.",
      "Amounts always tabular-nums, right-aligned.",
      "Max 2 weights per component."
    ]
  },
  "spacing": { "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 20, "xxl": 24 },
  "radius": { "sm": 8, "md": 12, "lg": 16, "pill": 999 },
  "elevation": {
    "card":   "0 1px 3px rgba(0,0,0,0.05)",
    "raised": "0 2px 10px rgba(0,0,0,0.06)",
    "fab":    "0 6px 16px rgba(240,82,60,0.45)"
  },
  "icon": {
    "library": "Material Symbols Rounded (weight 400, fill 0)",
    "size": { "xs": 14, "sm": 16, "md": 20, "lg": 24 },
    "rule": "No emojis anywhere in UI or copy."
  },
  "component": {
    "transactionRow": {
      "variant": "compact (default)",
      "minHeight": 64,
      "paddingX": 16,
      "paddingY": 10,
      "iconTile": { "size": 36, "radius": 10, "iconSize": 20 },
      "gap": 12,
      "lines": ["title (body) + amount (bodyStrong)", "meta (caption): Categoría · Subcat · Cuenta · Hora"],
      "chips": "inline at end of meta line, micro, height 18, paddingX 6",
      "separator": "1px border.subtle, inset 64 from left",
      "container": "rows grouped inside ONE card per day (radius lg), not one card per row"
    },
    "dayHeader": { "paddingX": 16, "paddingTop": 16, "paddingBottom": 8, "text": "headline", "net": "bodyStrong" },
    "summaryBar": { "height": 56, "radius": "lg", "elevation": "raised", "label": "caption", "value": "bodyStrong" },
    "chip": { "height": 20, "paddingX": 8, "radius": "pill", "text": "micro", "iconSize": 14 },
    "button": { "height": 48, "radius": "md", "text": "label/16 semibold", "primaryBg": "brand.primary" },
    "input": { "height": 44, "radius": "md", "fill": "surface.inputFill", "border": "border.input" },
    "bottomNav": { "height": 56, "iconSize": 24, "label": "micro", "active": "brand.primary", "inactive": "text.tertiary" },
    "fab": { "size": 56, "radius": "pill", "iconSize": 28, "elevation": "fab" }
  }
}
